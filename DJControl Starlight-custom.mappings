          <midi type="Note" parameter="0x32" channel="0x8" value="127" />
        </mapping>
        <mapping>
          <control alias="fam(Sampler)[0x2].Pad4Control" value="false" />
          <midi type="Note" parameter="0x33" channel="0x8" value="0" />
        </mapping>
        <mapping>
          <control alias="fam(Sampler)[0x2].Pad4Control" value="true" />
          <midi type="Note" parameter="0x33" channel="0x8" value="127" />
        </mapping>
      </output-mappings>
    </mappings>
  </controller>
</main>